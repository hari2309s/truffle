{
  "name": "truffle",
  "version": "1.0.0",
  "description": "Your finances, unearthed. A voice-first personal finance assistant that talks with you, not at you.",
  "author": "Hariharan Selvaraj <hariharan.2309.s@icloud.com> (https://github.com/hari2309s)",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "test": "vitest run --exclude 'apps/web/e2e/**'",
    "seed:demo": "node packages/db/scripts/seed-demo.mjs"
  },
  "devDependencies": {
    "@langfuse/client": "5.10.1",
    "@langfuse/otel": "5.10.1",
    "@langfuse/tracing": "5.10.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.0.0",
    "turbo": "^2.9.14",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "undici": "^8.12.2",
      "ws": "^8.21.0",
      "form-data": "^4.0.6",
      "postcss": "^8.5.23",
      "dompurify": "^3.4.17",
      "@opentelemetry/core": "^2.8.0",
      "baseline-browser-mapping": "^2.11.0",
      "postcss-selector-parser": ">=6.1.5",
      "fflate": "^0.4.9",
      "brace-expansion": ">=5.0.11",
      "js-yaml": ">=4.3.1",
      "browserslist": ">=4.28.7",
      "langsmith": ">=0.6.0",
      "@grpc/grpc-js": ">=1.14.5",
      "source-map-js": ">=1.2.2",
      "vite": "8.1.6",
      "zod": "^4.6.6",
      "@vitest/mocker": ">=4.1.12",
      "uuid": ">=11.1.1",
      "minimatch": ">=11.0.1",
      "cookie": ">=0.7.0",
      "esbuild": ">=0.28.1"
    }
  }
}
